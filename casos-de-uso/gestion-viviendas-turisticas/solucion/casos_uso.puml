@startuml Casos_Uso_Viviendas_Turisticas
skinparam backgroundColor #FAFAFA
skinparam handwritten false
skinparam usecase {
    BackgroundColor #E1F5FE
    BorderColor #0277BD
    ArrowColor #01579B
    ActorBackgroundColor #FFF3E0
    ActorBorderColor #E65100
}

title Diagrama de Casos de Uso\nPlataforma de Gestión de Viviendas Turísticas

' ===== ACTORES =====
actor "Cliente" as Cliente
actor "Propietario" as Propietario
actor "Administrador" as Admin

' ===== CASOS DE USO DEL PROPIETARIO =====
usecase "UC-1: Registrar\nalojamiento" as UC1
usecase "UC-2: Gestionar\ndisponibilidad" as UC2

' ===== CASOS DE USO DEL CLIENTE =====
usecase "UC-3: Buscar\nalojamientos" as UC3
usecase "UC-4: Crear\nreserva" as UC4
usecase "UC-5: Procesar\npago" as UC5
usecase "UC-6: Valorar\nalojamiento" as UC6

' ===== CASOS DE USO DEL ADMINISTRADOR =====
usecase "UC-7: Supervisar\nactividad" as UC7
usecase "UC-8: Bloquear\nanuncios" as UC8

' ===== RELACIONES: PROPIETARIO =====
Propietario -- UC1
Propietario -- UC2

' ===== RELACIONES: CLIENTE =====
Cliente -- UC3
Cliente -- UC4
Cliente -- UC5
Cliente -- UC6

' ===== RELACIONES: ADMINISTRADOR =====
Admin -- UC7
Admin -- UC8

' ===== RELACIONES ENTRE CASOS DE USO =====
UC4 ..> UC5 : <<include>>
UC4 ..> UC2 : <<include>>

' ===== NOTAS EXPLICATIVAS =====
note right of Cliente
  El cliente puede:
  • Buscar alojamientos
  • Crear reservas
  • Procesar pagos
  • Valorar su experiencia
end note

note right of Propietario
  El propietario puede:
  • Registrar nuevos alojamientos
  • Gestionar la disponibilidad
    (fechas, precios por temporada)
end note

note right of Admin
  El administrador puede:
  • Supervisar toda la actividad
  • Bloquear anuncios que violen
    las normas de uso
end note

@enduml